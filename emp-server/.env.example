# emp-server 环境变量样例
# 复制为 .env 仅用于本地记录；Spring Boot 不自动读取 .env，
# 启动前请通过系统环境变量、IDE Run Configuration 或 shell 注入。
# 完整默认值见 src/main/resources/application.yml。

# ---- 服务 ----
# SERVER_PORT=8080

# ---- MySQL ----
# 连接 URL 硬编码在 application.yml 中；如需改主机、端口或库名，可用 Spring Boot 松弛绑定覆盖：
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/enterprise_academy?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
API_RESPONSE_CACHE_TTL=1s

# ---- JWT ----
# 生产环境必须替换为随机且不少于 32 字节的密钥
EMP_JWT_SECRET=emp-academy-dev-secret-key-change-me-in-production-2025
EMP_JWT_EXPIRE_MINUTES=15
# 逗号分隔；留空时只允许本机 3000/5173 开发端口
EMP_ALLOWED_ORIGINS=

# ---- 登录与会话 ----
# 仅在可信反向代理之后设为 true，否则伪造 X-Forwarded-For 可绕过登录限流
AUTH_TRUST_FORWARDED_HEADERS=false
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_MAX_LOGIN_IP_ATTEMPTS=30
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_MAX_REGISTER_ATTEMPTS=5
AUTH_REGISTER_WINDOW_MINUTES=60
# 演示模式：允许空密码哈希的种子账号用 123456 登录；生产必须设为 false
EMP_DEMO_MODE=true

# ---- MinIO ----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=zhang
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=emp-academy
# 演示环境 true；生产建议 false 并统一使用预签名 URL
MINIO_PUBLIC_READ=true
