# emp-server 环境变量样例
# 复制为 .env 仅用于本地记录；Spring Boot 不自动读取 .env，
# 启动前请通过系统环境变量、IDE Run Configuration 或 shell 注入。

# ---- MySQL ----
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---- JWT ----
# 生产环境必须替换为随机且不少于 32 字节的密钥
EMP_JWT_SECRET=emp-academy-dev-secret-key-change-me-in-production-2025

# ---- MinIO ----
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=zhang
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=emp-academy
# 演示环境 true；生产建议 false 并统一使用预签名 URL
MINIO_PUBLIC_READ=true
